# Local development defaults ONLY — never production secrets.
# Copy to .env and change values locally if needed (.env stays git-ignored).
API_PORT=5000
# Host ports for the infra containers. The defaults avoid the classic 5432 /
# 6379 conflicts with other local stacks; the container ports never change.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=FlashSaleDb
REDIS_HOST=redis
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Where the order-api container sends the payment request. The default value is
# the docker-network name of the sibling payment-service container. An API
# running on the HOST must point it at the published host port instead:
# PAYMENT_SERVICE_URL=http://localhost:5002
PAYMENT_SERVICE_URL=http://payment-service:8080
# Kafka is experimental/opt-in (compose profile `experimental`).
KAFKA_BOOTSTRAP=kafka:9092
# Auth (ADR-013): HS256 signing key, minimum 32 bytes. The app refuses to start
# in the Production environment without one. Local dev only — production reads
# its key from the `flashsale-secrets` Kubernetes Secret (key `jwt-signing-key`).
JWT_SIGNING_KEY=CHANGE_ME_MIN_32_BYTES_HEX_OR_BASE64
