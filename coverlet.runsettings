<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Threshold>75</Threshold>
          <ThresholdType>line</ThresholdType>
          <Exclude>
            <ExcludeFilter>**/*Tests*</ExcludeFilter>
            <ExcludeFilter>**/obj/**</ExcludeFilter>
            <ExcludeFilter>**/bin/**</ExcludeFilter>
            <ExcludeFilter>**/*.g.cs</ExcludeFilter>
            <ExcludeFilter>**/*.g.i.cs</ExcludeFilter>
            <ExcludeFilter>**/Program.cs</ExcludeFilter>
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
