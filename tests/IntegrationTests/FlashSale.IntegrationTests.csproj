<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Phase IV E2E: WebApplicationFactory boots the REAL Program.cs composition
         over an in-memory TestServer, so the auth flow is exercised through the
         same middleware pipeline the deployed API uses instead of a re-creation
         of it. Version tracks the ASP.NET Core 10.0.x runtime. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.12.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="3.12.0" />
    <PackageReference Include="Testcontainers.Redis" Version="3.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- Phase 5 security gate: Testcontainers 4.0.0 pulls SSH.NET 2023.0.0
         transitively (used only for remote Docker hosts over SSH), which has
         HIGH CVEs fixed in 2026.0.0 (CVE-2026-48798, CVE-2026-85756). The
         package ID moved from Renci.SshNet to SSH.NET; this direct reference
         pins NuGet resolution to the patched version. Local tests use the
         Docker unix socket (no SSH) and the integration run proves it works. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlashSale.Application\FlashSale.Application.csproj" />
    <ProjectReference Include="..\..\src\FlashSale.Infrastructure\FlashSale.Infrastructure.csproj" />
    <!-- Phase IV: the E2E test drives the API host itself (Program.cs), so the
         composition root is under test rather than trusted.
         The alias keeps the top-level Program class addressable while the
         Payment.Service reference (below) exposes a second one. -->
    <ProjectReference Include="..\..\src\Order.Api\Order.Api.csproj">
      <Aliases>order</Aliases>
    </ProjectReference>
  </ItemGroup>

  <!-- The Payment.Service tests belong to the in-flight Payment stream: they
       need `extern alias payment` and the Payment.Service implementation,
       which is NOT part of this branch (it lives in untracked files of another
       work stream). Excluding them here keeps this branch's integration test
       project compilable; the Payment stream verifies its own tests. -->
  <ItemGroup>
    <Compile Remove="Payment/**" />
    <Compile Remove="PaymentServiceTests.cs" />
  </ItemGroup>

</Project>
